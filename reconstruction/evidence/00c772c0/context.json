    "05_decompilation": {
      "data": "\nbool __thiscall FUN_00c772c0(int param_1,uint param_2)\n\n{\n  uint *puVar1;\n  int iVar2;\n  \n  iVar2 = 0;\n  for (puVar1 = *(uint **)(*(int *)(param_1 + 0x1120) + (param_2 % *(uint *)(param_1 + 0x1124)) * 4)\n      ; puVar1 != (uint *)0x0; puVar1 = (uint *)puVar1[1]) {\n    if (param_2 == *puVar1) {\n      iVar2 = iVar2 + 1;\n    }\n  }\n  return iVar2 != 0;\n}\n\n",
      "omitted": {
