{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "ghidra": {
      "type": "local",
      "command": [
        "/home/juanr/.local/bin/uv",
        "run",
        "--no-sync",
        "--directory",
        "/home/juanr/apps/ghidra-mcp",
        "bridge-mcp-ghidra",
        "--transport",
        "stdio"
      ],
      "environment": {
        "GHIDRA_MCP_URL": "http://127.0.0.1:8089"
      },
      "enabled": true
    }
  }
}
