  "semantic_edge_errors": [
    {
      "id": "SGE-001",
      "severity": "high",
      "category": "asserted_unresolved_overlap",
      "edge_ids": [
        "E-003",
        "E-011",
        "E-021",
        "E-028",
        "E-039",
        "E-040"
      ],
      "unresolved_edge_ids": [
        "U-001",
        "U-003",
        "U-005",
        "U-006",
        "U-009",
        "U-010"
      ],
      "endpoint_pairs": [
        {
          "from": "N-RESOURCE-KEY",
          "to": "N-ASSET-REGISTRY",
          "asserted_edge": "E-003",
          "unresolved_edge": "U-001"
        },
        {
          "from": "N-CELL-RUNTIME-STATE",
          "to": "N-EVENT-DATA",
          "asserted_edge": "E-011",
          "unresolved_edge": "U-003"
        },
        {
          "from": "N-PLANET-DATA",
          "to": "N-SPACE-DATA",
          "asserted_edge": "E-021",
          "unresolved_edge": "U-006"
        },
        {
          "from": "N-EVENT-DATA",
          "to": "N-MESSAGE-SYSTEM",
          "asserted_edge": "E-028",
          "unresolved_edge": "U-010"
        },
        {
          "from": "N-PRESENTATION-DATA",
          "to": "N-MODEL-ASSETS",
          "asserted_edge": "E-039",
          "unresolved_edge": "U-009"
        },
        {
          "from": "N-EDITOR-DATA",
          "to": "N-PRESENTATION-DATA",
          "asserted_edge": "E-040",
          "unresolved_edge": "U-005"
        }
      ],
      "finding": "Six endpoint pairs are simultaneously asserted in edges and marked unresolved. The graph needs one canonical relation per bounded claim, with narrower unresolved claims kept as separate relation types or retained only in unresolved_edges.",
      "resolution": "Split name mapping from identity lookup, event consequence from event transport, generated planet data from live surface transition, presentation reference from complete asset semantics, and editor presentation projection from save/apply validation."
    },
    {
      "id": "SGE-002",
      "severity": "medium",
      "category": "direction_or_relation_type",
      "edge_id": "E-007",
      "finding": "N-CELL-CONTENT is a content-family aggregate and E-007 types it as references to N-CELL-WORLD-DATA, while the underlying records describe world/populate/advect composition from the world side. The direction is ambiguous and the relation type is not containment.",
      "resolution": "Use N-CELL-CONTENT -> N-CELL-WORLD-DATA with type contains only if the family is explicitly a parent aggregate; otherwise use N-CELL-WORLD-DATA -> N-CELL-CONTENT with type references."
    },
    {
      "id": "SGE-003",
      "severity": "high",
      "category": "direction_and_scope",
      "edge_id": "E-021",
      "finding": "E-021 is N-PLANET-DATA -> N-SPACE-DATA and is paired with E-019 N-SPACE-DATA -> N-PLANET-DATA. Because N-SPACE-DATA is itself a logical aggregate containing planet records, the pair does not represent a clean generated-record-to-live-surface transition and has no terrain/presentation target.",
      "resolution": "Split generated PlanetData and live planet/terrain state into separate nodes; connect PlanetData -> PlanetRuntime/TerrainState rather than back to the SpaceData aggregate."
    },
    {
      "id": "SGE-004",
      "severity": "medium",
      "category": "direction_or_relation_type",
      "edge_id": "E-027",
      "finding": "E-027 is N-CITY-DATA -> N-PRESENTATION-DATA with type contains, but its description says city/building spatial state is consumed by presentation. Presentation does not contain gameplay city data.",
      "resolution": "Use N-CITY-DATA -> N-PRESENTATION-DATA with type feeds or projects_to, and keep city/layout ownership separate from renderer state."
    },
    {
      "id": "SGE-005",
      "severity": "high",
      "category": "inverted_direction",
      "edge_id": "E-030",
      "finding": "E-030 is N-PROPERTY-LIST -> N-CONFIGURATION-DATA with type uses, but configuration consumes PropertyList as a substrate. The direction is inverted for a configuration dependency.",
      "resolution": "Use N-CONFIGURATION-DATA -> N-PROPERTY-LIST with type uses, or use a non-directional relation type such as backed_by."
    },
    {
      "id": "SGE-006",
      "severity": "medium",
      "category": "ambiguous_reciprocal_routing",
      "edge_ids": [
        "E-028",
        "E-043"
      ],
      "finding": "E-028 routes event data into the message system and E-043 routes message-system output back into event data. The input artifacts preserve distinct event records, message records, queue records, and dispatch ownership, so reciprocal routes collapse an unresolved dispatch boundary into a cycle.",
      "resolution": "Keep one edge per operation, such as enqueues, dispatches_to_listener, or observes, and retain the distinct event/message node types."
    },
    {
      "id": "SGE-007",
      "severity": "high",
      "category": "inverted_direction",
      "edge_id": "E-047",
      "finding": "E-047 is N-OBJECT-REGISTRY -> N-SAVE-DATA with type reconstructs, while the persistence service is the actor that serializes or restores registry-owned objects. The description confirms that pointer restoration is unresolved, not that the registry reconstructs persistence.",
      "resolution": "Use N-SAVE-DATA -> N-OBJECT-REGISTRY with type reconstructs for load, or N-OBJECT-REGISTRY -> N-SAVE-DATA with type serializes; retain the unresolved pointer-restoration caveat."
    },
    {
      "id": "SGE-008",
      "severity": "medium",
      "category": "parallel_edges",
      "edge_ids": [
        "E-014",
        "E-017"
      ],
      "endpoint_pair": {
        "from": "N-CREATURE-RIGBLOCK",
        "to": "N-PRESENTATION-DATA"
      },
      "finding": "Two distinct edge types, resolves_to and derives, share the same endpoints. They are not exact duplicates, but without explicit relation partitioning they can be interpreted as duplicate semantic claims.",
      "resolution": "Retain both only if model-reference resolution and derived-skin production are separate graph relations; otherwise merge after evidence review and preserve the distinction in descriptions."
    }
  ],
